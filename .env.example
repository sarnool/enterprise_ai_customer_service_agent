# OpenAI-compatible API Configuration
# Works with a real OpenAI key, or an OpenRouter key (recommended for a
# bootcamp session - one key can be issued to every participant instead of
# individual OpenAI keys). Same variable name either way.
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Leave unset to talk to OpenAI directly. Set to route through an
# OpenAI-API-compatible provider instead - config/llm_config.yaml is
# currently set up for OpenRouter, which needs this exact URL and
# provider-namespaced model names (e.g. "openai/gpt-4").
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model name, temperature, and token settings actually come from
# config/llm_config.yaml, not from env vars - LLM_MODEL, EMBEDDING_MODEL,
# LLM_TEMPERATURE, and MAX_TOKENS below are illustrative only and not read
# by any module. Edit config/llm_config.yaml to change them.
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.7
MAX_TOKENS=2000

# Vector Database Configuration
VECTOR_DB_PATH=./vector_store
# VECTOR_DB_COLLECTION is illustrative only - not read by any module (FAISS
# indexes here are single-collection, addressed by VECTOR_DB_PATH alone).
VECTOR_DB_COLLECTION=enterprise_knowledge

# Application Configuration
# APP_NAME and APP_VERSION are illustrative only - not read by any module.
APP_NAME=Enterprise AI Customer Operations Agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Agent Configuration
MAX_RETRIEVAL_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.7
# ENABLE_TOOLS and ENABLE_CLARIFICATION are illustrative only - not read by
# any module (both capabilities are always active in the current workflow).
ENABLE_TOOLS=true
ENABLE_CLARIFICATION=true

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
